{
    "entryFile": "src/server.ts",
    "noImplicitAdditionalProperties": "throw-on-extras",
    "controllerPathGlobs": [
        "src/controllers/*controller.ts"
    ],
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "spec": {
        "outputDirectory": "build",
        "specVersion": 3
    },
    "routes": {
        "routesDir": "src/generated",
        "iocModule": "src/inversify.config.ts"
    }
}