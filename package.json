{
  "name": "loyalty_apps",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "clear": "find ./ -name \"node_modules\" -type d -exec rm -rf {} + && find ./ -name \".next\" -type d -exec rm -rf {} + && find ./ -name \".turbo\" -type d -exec rm -rf {} + && find ./ -name \"venv\" -type d -exec rm -rf {} + && find ./ -name \"dist\" -type d -exec rm -rf {} +",
    "supabase:start": "supabase start -x realtime,mailpit,edge-runtime,vector",
    "supabase:gen": "supabase gen types typescript --local > packages/database-types/src/database.types.ts"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.0",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
      "overrides": {
        "glob": ">=11.0.0" 
      }
    }
}
